{
	"name": "@phpvms/addon-registry",
	"version": "0.0.0",
	"private": true,
	"description": "phpVMS addon registry — curated catalogue validated against a JSON schema",
	"type": "module",
	"engines": {
		"bun": ">=1.1"
	},
	"scripts": {
		"validate": "bun scripts/validate.ts",
		"publish": "bun scripts/publish.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"format": "prettier --write ."
	},
	"dependencies": {
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"php-parser": "^3.2.2",
		"yaml": "^2.6.0",
		"yauzl": "^3.3.0"
	},
	"devDependencies": {
		"@types/bun": "^1.1.10",
		"@types/node": "^22.7.5",
		"@types/yauzl": "^2.10.3",
		"prettier": "^3.3.3",
		"typescript": "^5.6.2"
	}
}
