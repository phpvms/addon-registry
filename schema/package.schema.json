{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://registry.phpvms.net/schema/package.schema.json",
	"title": "phpVMS addon registry publisher file",
	"type": "object",
	"additionalProperties": false,
	"required": ["meta", "addons"],
	"properties": {
		"meta": {
			"type": "object",
			"additionalProperties": false,
			"required": ["publisher", "name", "url", "maintainers"],
			"properties": {
				"publisher": {
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
					"description": "Publisher namespace identifier. Must match the packages/{publisher}.yml file name stem. Lowercase letters, digits, and hyphens; at least two characters; must start and end with a letter or digit."
				},
				"name": {
					"type": "string",
					"minLength": 1,
					"description": "Display name of the publisher."
				},
				"url": {
					"type": "string",
					"minLength": 1,
					"format": "uri",
					"description": "Publisher website URL."
				},
				"maintainers": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					},
					"description": "List of maintainer identifiers (e.g. GitHub usernames)."
				}
			}
		},
		"addons": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/addon" }
		}
	},
	"$defs": {
		"addon": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "description", "category", "license", "keywords", "source", "requirements"],
			"properties": {
				"name": {
					"type": "string",
					"description": "Unqualified addon identifier (single segment). Lowercase letters, digits, and hyphens; at least two characters; must start and end with a letter or digit.",
					"pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
				},
				"description": {
					"type": "string",
					"minLength": 1,
					"maxLength": 500
				},
			"category": {
				"type": "string",
				"enum": ["accounting", "communications", "crew", "dev-tools", "integration", "operations", "pireps", "reporting", "scheduling", "templates", "ui", "widget", "other"],
				"description": "Single category for the addon."
			},
				"license": {
					"type": "string",
					"minLength": 1,
					"description": "SPDX license identifier (validated by string presence here; deeper validation is out of scope for v1)."
				},
				"keywords": {
					"type": "array",
					"maxItems": 5,
					"items": {
						"type": "string",
						"minLength": 1,
						"maxLength": 12
					},
					"description": "Free-form tags. Order is preserved into the published index. At most 5 keywords, each up to 12 characters."
				},
				"source": {
					"type": "object",
					"additionalProperties": false,
					"required": ["type"],
					"description": "Where the addon's release zip comes from. The `type` selects the source implementation; type-specific fields are validated by the matching `allOf` branch below.",
					"properties": {
						"type": {
							"type": "string",
							"enum": ["github-release"],
							"description": "Source kind. Add new kinds here and register a matching source under scripts/lib/sources/."
						},
						"repository": {
							"type": "string",
							"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$",
							"description": "GitHub repository in `owner/repo` format (github-release sources)."
						}
					},
					"allOf": [
						{
							"if": {
								"properties": { "type": { "const": "github-release" } }
							},
							"then": {
								"required": ["repository"]
							}
						}
					]
				},
				"requirements": {
					"type": "object",
					"required": ["php", "phpvms"],
					"properties": {
						"php": {
							"type": "string",
							"minLength": 1
						},
						"phpvms": {
							"type": "string",
							"minLength": 1
						},
						"extensions": {
							"description": "Deferred to v2; ignored by the v1 validator.",
							"type": "array",
							"items": { "type": "string" }
						}
					},
					"additionalProperties": true
				},
				"revoked": {
					"type": "boolean"
				},
				"revoked_reason": {
					"type": "string",
					"minLength": 1
				},
				"archived": {
					"type": "boolean"
				},
				"archived_reason": {
					"type": "string",
					"minLength": 1
				}
			},
			"allOf": [
				{
					"if": {
						"required": ["revoked_reason"]
					},
					"then": {
						"properties": {
							"revoked": { "const": true }
						},
						"required": ["revoked"]
					}
				},
				{
					"if": {
						"required": ["archived_reason"]
					},
					"then": {
						"properties": {
							"archived": { "const": true }
						},
						"required": ["archived"]
					}
				}
			]
		}
	}
}
