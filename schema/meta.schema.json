{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://registry.phpvms.net/schema/meta.schema.json",
	"title": "phpVMS addon registry namespace metadata",
	"type": "object",
	"additionalProperties": false,
	"required": ["name", "url", "maintainers"],
	"properties": {
		"name": {
			"type": "string",
			"minLength": 1,
			"description": "Display name for the namespace (e.g. \"Acme Corp\")."
		},
		"url": {
			"type": "string",
			"format": "uri",
			"pattern": "^https?://"
		},
		"maintainers": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string",
				"minLength": 1,
				"pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38}[A-Za-z0-9])?$",
				"description": "GitHub username (1-39 chars, no leading/trailing hyphen)."
			}
		}
	}
}
