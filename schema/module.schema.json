{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://registry.phpvms.net/schema/module.schema.json",
	"title": "phpVMS addon module.json",
	"type": "object",
	"required": ["name", "alias", "description", "keywords", "active", "order", "providers", "aliases", "files", "requires"],
	"properties": {
		"name": {
			"type": "string",
			"minLength": 1
		},
		"alias": {
			"type": "string",
			"minLength": 1
		},
		"description": {
			"type": "string"
		},
		"keywords": {
			"type": "array",
			"items": { "type": "string" }
		},
		"active": {
			"type": "boolean"
		},
		"order": {
			"type": "integer"
		},
		"providers": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"aliases": {
			"type": "object"
		},
		"files": {
			"type": "array",
			"items": { "type": "string" }
		},
		"requires": {
			"type": "array",
			"items": { "type": "string" }
		}
	},
	"additionalProperties": true
}
